{
  "name": "local-harness",
  "version": "0.1.1",
  "description": "One JavaScript API for the AI agent CLIs installed on this machine (Claude Code, Cursor, Codex, Gemini CLI, OpenCode): discover them, read their models and capabilities, and send prompts.",
  "keywords": [
    "ai",
    "agent",
    "harness",
    "claude-code",
    "cursor",
    "codex",
    "gemini-cli",
    "opencode",
    "cli",
    "llm"
  ],
  "author": "Davide Di Modica",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linko91/local-harness.git"
  },
  "homepage": "https://github.com/Linko91/local-harness#readme",
  "bugs": {
    "url": "https://github.com/Linko91/local-harness/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
